<?xml version="1.0" encoding="UTF-8"?>
<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>local</groupId>
  <artifactId>spark-lakehouse-deps</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>

  <properties>
    <iceberg.version>1.7.1</iceberg.version>
    <!-- The Nessie Spark extensions are only released for some server versions.
         The latest Spark 3.5 / Scala 2.12 build on Maven Central is 0.106.0,
         which is wire-compatible with the 0.107.x Nessie server image used by
         docker-compose. Older extensions (e.g. 0.99.x) speak only the Nessie
         native REST API v1 and fail against a v2 server with "API version
         mismatch" when running `CREATE BRANCH`/`USE REFERENCE`. -->
    <nessie.version>0.106.0</nessie.version>
    <spark.compat>3.5</spark.compat>
    <scala.compat>2.12</scala.compat>
    <!-- Must match the Hadoop client shipped inside the Spark tarball (Spark
         3.5.8 bundles hadoop-client-api/runtime 3.3.4). Using a newer
         `hadoop-aws` here leads to runtime NoClassDefFoundError on classes
         that were added to hadoop-common in 3.3.5+ (e.g. PrefetchingStatistics). -->
    <hadoop.version>3.3.4</hadoop.version>
    <aws.sdk.version>2.29.45</aws.sdk.version>
  </properties>

  <dependencies>
    <!-- Iceberg Spark runtime (includes Spark extensions) -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-spark-runtime-${spark.compat}_${scala.compat}</artifactId>
      <version>${iceberg.version}</version>
    </dependency>

    <!-- Iceberg AWS bundle (S3FileIO + Glue support) -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws-bundle</artifactId>
      <version>${iceberg.version}</version>
    </dependency>

    <!-- Nessie Spark extensions (branching, merging) -->
    <dependency>
      <groupId>org.projectnessie.nessie-integrations</groupId>
      <artifactId>nessie-spark-extensions-${spark.compat}_${scala.compat}</artifactId>
      <version>${nessie.version}</version>
    </dependency>

    <!-- Hadoop AWS (s3a filesystem implementation)
         NOTE: hadoop-aws 3.3.x requires the AWS SDK v1 `aws-java-sdk-bundle`
         (`com.amazonaws.*`) at runtime. Iceberg uses AWS SDK v2 via
         `iceberg-aws-bundle` (`software.amazon.awssdk.*`) — different package
         namespaces, so the two bundles coexist without conflict. Do NOT
         exclude `aws-java-sdk-bundle` here or any `s3a://` read (e.g. the
         `file_ingest` DAG staging CSVs via Spark) will fail with
         `NoClassDefFoundError: com/amazonaws/AmazonClientException`. -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-aws</artifactId>
      <version>${hadoop.version}</version>
    </dependency>
  </dependencies>
</project>
